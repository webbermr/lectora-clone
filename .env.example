# Settings for docker compose. Copy this file to .env (in the same folder as docker-compose.yml)
# and fill in what you use:
#
#   macOS / Linux:        cp .env.example .env
#   Windows PowerShell:   Copy-Item .env.example .env
#
# .env is never committed or copied into the image, so your key stays on this computer.
# After changing it, run: docker compose up -d

# --- Ask SCORM (the AI assistant) ----------------------------------------------------------------
# An Anthropic API key (from console.anthropic.com). The container adds it to SCORM's requests itself,
# so it never reaches anyone's browser. Everyone who can open the editor can use SCORM on this key.
# Leave it empty and each person can enter their own key in SCORM's settings instead.
ANTHROPIC_API_KEY=

# --- HTTPS, so other computers on your network can use the editor ----------------------------------
# Leave these commented out to use the editor only on this computer (http://localhost:8080).
# To turn HTTPS on, remove the # in front of both lines and put this computer's network address in
# SITE_ADDRESS. The README's "Let other people on your network use it" covers the certificate setup.
# COMPOSE_PROFILES=https
# SITE_ADDRESS=192.168.1.50

# Optional: the name your network has for this computer, if it has one.
# SITE_NAME=lectora.office.lan
